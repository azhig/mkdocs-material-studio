            "cyan",
            "teal",
            "green",
            "light green",
            "lime",
            "yellow",
            "amber",
            "orange",
            "deep orange"
          ],
          "default": "",
          "markdownDescription": "%config.palette.dark.accent%"
        },
        "mkdocsStudio.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.followActiveEditor%"
        },
        "mkdocsStudio.scrollSync": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.scrollSync%"
        },
        "mkdocsStudio.imagePasteFolder": {
          "type": "string",
          "default": "assets",
          "markdownDescription": "%config.imagePasteFolder%"
        },
        "mkdocsStudio.inlineFormatting": {
          "type": "string",
          "enum": [
            "selection",
            "both",
            "toolbar"
          ],
          "enumDescriptions": [
            "%config.inlineFormatting.enum.0%",
            "%config.inlineFormatting.enum.1%",
            "%config.inlineFormatting.enum.2%"
          ],
          "default": "both",
          "markdownDescription": "%config.inlineFormatting%"
        },
        "mkdocsStudio.toolbarButtons": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "table",
              "image",
              "code",
              "hr",
              "admonition",
              "tabs",
              "icon",
              "grid",
              "diagram",
              "button",
              "annotation",
              "footnote",
              "tooltip",
              "math"
            ]
          },
          "default": [
            "table",
            "image",
            "code",
            "hr"
          ],
          "markdownDescription": "%config.toolbarButtons%"
        },
        "mkdocsStudio.keybindings": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "%config.keybindings%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "compile": "tsc --noEmit -p tsconfig.ext.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.integration.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node esbuild.mjs --tests && vscode-test",
    "check": "npm run compile && npm run lint && npm run format:check && npm run test:unit",
    "vsix": "npm run package && vsce package --no-dependencies",
    "icon": "node scripts/build-icon.mjs",
    "demo": "node scripts/record-demo.mjs",
    "harness": "node scripts/harness/server.mjs",
    "vscode:prepublish": "node esbuild.mjs --production",
    "shots": "node scripts/shoot-screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "1.90.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.13.0",
    "happy-dom": "^20.11.1",
    "mocha": "^11.8.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.11.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@plantuml/core": "^1.2026.6",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.1",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-attrs": "^5.0.0",
    "markdown-it-deflist": "^3.0.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.1",
    "yaml": "^2.9.0"
  },
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#3949ab",
    "theme": "dark"
  },
  "homepage": "https://github.com/azhig/mkdocs-material-studio#readme",
  "qna": false,
  "overrides": {
    "dompurify": "^3.4.13",
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3"
  }
}
