{
  "name": "mkdocs-material-studio",
  "displayName": "MkDocs Material Studio",
  "description": "%extension.description%",
  "version": "0.3.0",
  "publisher": "azhig",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/azhig/mkdocs-material-studio"
  },
  "bugs": {
    "url": "https://github.com/azhig/mkdocs-material-studio/issues"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces%"
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "mkdocs",
    "material",
    "markdown",
    "preview",
    "documentation"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:mkdocs.yml",
    "workspaceContains:mkdocs.yaml",
    "onLanguage:markdown"
  ],
  "contributes": {
    "keybindings": [
      {
        "command": "mkdocsStudio.saveVisual",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == 'mkdocsStudio.visualEditor'"
      }
    ],
    "commands": [
      {
        "command": "mkdocsStudio.saveVisual",
        "title": "%command.saveVisual%",
        "category": "MkDocs",
        "icon": "$(save)"
      },
      {
        "command": "mkdocsStudio.openPreview",
        "title": "%command.openPreview%",
        "category": "MkDocs",
        "icon": "$(book)"
      },
      {
        "command": "mkdocsStudio.openPreviewToSide",
        "title": "%command.openPreviewToSide%",
        "category": "MkDocs",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "mkdocsStudio.showLogs",
        "title": "%command.showLogs%",
        "category": "MkDocs"
      },
      {
        "command": "mkdocsStudio.tree.refresh",
        "title": "%command.tree.refresh%",
        "category": "MkDocs",
        "icon": "$(refresh)"
      },
      {
        "command": "mkdocsStudio.tree.newPage",
        "title": "%command.tree.newPage%",
        "category": "MkDocs",
        "icon": "$(new-file)"
      },
      {
        "command": "mkdocsStudio.tree.newSection",
        "title": "%command.tree.newSection%",
        "category": "MkDocs",
        "icon": "$(new-folder)"
      },
      {
        "command": "mkdocsStudio.tree.rename",
        "title": "%command.tree.rename%",
        "category": "MkDocs"
      },
      {
        "command": "mkdocsStudio.tree.delete",
        "title": "%command.tree.delete%",
        "category": "MkDocs"
      },
      {
        "command": "mkdocsStudio.tree.openConfig",
        "title": "%command.tree.openConfig%",
        "category": "MkDocs"
      },
      {
        "command": "mkdocsStudio.openConfigEditor",
        "title": "%command.openConfigEditor%",
        "category": "MkDocs",
        "icon": "$(settings-gear)"
      },
      {
        "command": "mkdocsStudio.insertComponent",
        "title": "%command.insertComponent%",
        "category": "MkDocs",
        "icon": "$(add)"
      },
      {
        "command": "mkdocsStudio.openVisualEditor",
        "title": "%command.openVisualEditor%",
        "category": "MkDocs",
        "icon": "$(edit)"
      },
      {
        "command": "mkdocsStudio.openAsText",
        "title": "%command.openAsText%",
        "category": "MkDocs",
        "icon": "$(go-to-file)"
      }
    ],
    "customEditors": [
      {
        "viewType": "mkdocsStudio.visualEditor",
        "displayName": "%customEditor.visualEditor%",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "mkdocsStudio.projectTree",
          "name": "MkDocs",
          "when": "mkdocsStudio.isProject"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "mkdocsStudio.openPreview",
          "when": "editorLangId == markdown && activeCustomEditorId != 'mkdocsStudio.visualEditor'",
          "group": "navigation@1",
          "alt": "mkdocsStudio.openPreviewToSide"
        },
        {
          "command": "mkdocsStudio.openVisualEditor",
          "when": "editorLangId == markdown && activeCustomEditorId != 'mkdocsStudio.visualEditor'",
          "group": "navigation@2"
        },
        {
          "command": "mkdocsStudio.openAsText",
          "when": "activeCustomEditorId == 'mkdocsStudio.visualEditor'",
          "group": "navigation@1"
        },
        {
          "command": "mkdocsStudio.insertComponent",
          "when": "editorLangId == markdown",
          "group": "1_mkdocs@1"
        }
      ],
      "editor/context": [
        {
          "command": "mkdocsStudio.insertComponent",
          "when": "editorLangId == markdown",
          "group": "1_modification"
        }
      ],
      "explorer/context": [
        {
          "command": "mkdocsStudio.openVisualEditor",
          "when": "resourceExtname == .md",
          "group": "navigation@10"
        }
      ],
      "commandPalette": [
        {
          "command": "mkdocsStudio.openAsText",
          "when": "false"
        },
        {
          "command": "mkdocsStudio.openPreview"
        },
        {
          "command": "mkdocsStudio.openPreviewToSide"
        },
        {
          "command": "mkdocsStudio.showLogs"
        },
        {
          "command": "mkdocsStudio.insertComponent"
        },
        {
          "command": "mkdocsStudio.openVisualEditor"
        },
        {
          "command": "mkdocsStudio.openConfigEditor"
        },
        {
          "command": "mkdocsStudio.tree.openConfig"
        },
        {
          "command": "mkdocsStudio.tree.rename",
          "when": "false"
        },
        {
          "command": "mkdocsStudio.tree.delete",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "mkdocsStudio.tree.newPage",
          "when": "view == mkdocsStudio.projectTree",
          "group": "navigation@1"
        },
        {
          "command": "mkdocsStudio.tree.newSection",
          "when": "view == mkdocsStudio.projectTree",
          "group": "navigation@2"
        },
        {
          "command": "mkdocsStudio.openConfigEditor",
          "when": "view == mkdocsStudio.projectTree",
          "group": "navigation@3"
        },
        {
          "command": "mkdocsStudio.tree.refresh",
          "when": "view == mkdocsStudio.projectTree",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "mkdocsStudio.tree.newPage",
          "when": "view == mkdocsStudio.projectTree && viewItem == section",
          "group": "1_new@1"
        },
        {
          "command": "mkdocsStudio.tree.newSection",
          "when": "view == mkdocsStudio.projectTree && viewItem == section",
          "group": "1_new@2"
        },
        {
          "command": "mkdocsStudio.tree.rename",
          "when": "view == mkdocsStudio.projectTree && (viewItem == section || viewItem == page)",
          "group": "2_edit@1"
        },
        {
          "command": "mkdocsStudio.tree.delete",
          "when": "view == mkdocsStudio.projectTree && (viewItem == section || viewItem == page || viewItem == loose)",
          "group": "2_edit@2"
        }
      ]
    },
    "configuration": {
      "title": "MkDocs Material Studio",
      "properties": {
        "mkdocsStudio.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ru",
            "de",
            "es",
            "fr",
            "pt-br",
            "zh-cn",
            "ja"
          ],
          "enumDescriptions": [
            "%config.language.enum.0%",
            "English",
            "English",
            "Deutsch",
            "Español",
            "Français",
            "Português (Brasil)",
            "简体中文",
            "日本語"
          ],
          "default": "auto",
          "markdownDescription": "%config.language%"
        },
        "mkdocsStudio.showSiteHeader": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.showSiteHeader%"
        },
        "mkdocsStudio.showSiteNav": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.showSiteNav%"
        },
        "mkdocsStudio.showToc": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.showToc%"
        },
        "mkdocsStudio.pageBackground": {
          "type": "string",
          "enum": [
            "material",
            "editor"
          ],
          "enumDescriptions": [
            "%config.pageBackground.enum.0%",
            "%config.pageBackground.enum.1%"
          ],
          "default": "material",
          "markdownDescription": "%config.pageBackground%"
        },
        "mkdocsStudio.palette.light.primary": {
          "type": "string",
          "enum": [
            "",
            "red",
            "pink",
            "purple",
            "deep purple",
            "indigo",
            "blue",
            "light blue",
            "cyan",
            "teal",
            "green",
            "light green",
            "lime",
            "yellow",
            "amber",
            "orange",
            "deep orange",
            "brown",
            "grey",
            "blue grey",
            "black",
            "white"
          ],
          "enumDescriptions": [
            "%config.palette.enum.unset%",
            "red",
            "pink",
            "purple",
            "deep purple",
            "indigo",
            "blue",
            "light blue",
            "cyan",
            "teal",
            "green",
            "light green",
            "lime",
            "yellow",
            "amber",
            "orange",
            "deep orange",
            "brown",
            "grey",
            "blue grey",
            "black",
            "white"
          ],
          "default": "",
          "markdownDescription": "%config.palette.light.primary%"
        },
        "mkdocsStudio.palette.light.accent": {
          "type": "string",
          "enum": [
            "",
            "red",
            "pink",
            "purple",
            "deep purple",
            "indigo",
            "blue",
            "light blue",
            "cyan",
            "teal",
            "green",
            "light green",
            "lime",
            "yellow",
            "amber",
            "orange",
            "deep orange"
          ],
          "enumDescriptions": [
            "%config.palette.enum.unset%",
            "red",
            "pink",
            "purple",
            "deep purple",
            "indigo",
            "blue",
            "light blue",
            "cyan",
            "teal",
            "green",
            "light green",
            "lime",
            "yellow",
            "amber",
            "orange",
            "deep orange"
          ],
          "default": "",
          "markdownDescription": "%config.palette.light.accent%"
        },
        "mkdocsStudio.palette.dark.primary": {
          "type": "string",
          "enum": [
            "",
            "red",
            "pink",
            "purple",
            "deep purple",
            "indigo",
            "blue",
            "light blue",
            "cyan",
            "teal",
            "green",
            "light green",
            "lime",
            "yellow",
            "amber",
            "orange",
            "deep orange",
            "brown",
            "grey",
            "blue grey",
            "black",
            "white"
          ],
          "enumDescriptions": [
            "%config.palette.enum.unset%",
            "red",
            "pink",
            "purple",
            "deep purple",
            "indigo",
            "blue",
            "light blue",
            "cyan",
            "teal",
            "green",
            "light green",
            "lime",
            "yellow",
            "amber",
            "orange",
            "deep orange",
            "brown",
            "grey",
            "blue grey",
            "black",
            "white"
          ],
          "default": "",
          "markdownDescription": "%config.palette.dark.primary%"
        },
        "mkdocsStudio.palette.dark.accent": {
          "type": "string",
          "enum": [
            "",
            "red",
            "pink",
