.DS_Store

# Temporary directory of scripts/fetch-material-assets.mjs
.asset-tmp/

# Local tooling configuration, not part of the project
.claude/

# Downloaded VS Code and its profile for the integration tests
.vscode-test/

# Coverage reports of the unit suite
coverage/

# A page to try the editor on: the language and formatting checks read every
# file that is not ignored, so a scratch reproduction goes here rather than in
# the working tree, where it would turn the suite red.
scratch/

# The icon sets are unpacked here by scripts/fetch-material-assets.mjs and then
# packed into icons.pack — only the pack is kept.
assets/icons/svg/
